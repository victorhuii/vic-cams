# Required only for Remote Duo. Never use a service-role/secret key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Optional TURN relay for restrictive networks. Use short-lived credentials
# issued by your TURN provider for a production deployment.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Enable only AFTER applying the gallery migration and enabling Anonymous Sign-Ins.
VITE_CLOUD_ARCHIVE_ENABLED=false
